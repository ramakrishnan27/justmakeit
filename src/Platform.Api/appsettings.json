{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "App": "Host=localhost;Port=5432;Database=justmakeitcamp;Username=app_user",
    "Migrator": "Host=localhost;Port=5432;Database=justmakeitcamp;Username=postgres"
  },
  "Database": {
    "MigrateOnStartup": false,
    "AppPassword": "",
    "MigratorPassword": ""
  },
  "Jwt": {
    "Issuer": "platform",
    "Audience": "platform-web",
    "AccessTokenDays": 30
  },
  "RateLimiting": {
    "Auth": {
      "CredentialRequestsPerWindow": 10,
      "SessionRequestsPerWindow": 60,
      "WindowSeconds": 60
    }
  },
  "SiteAdmin": {
    "Email": "",
    "Password": ""
  },
  "Cors": {
    "WebOrigin": ""
  },
  "Content": {
    "Publishing": {
      "WorkerEnabled": true,
      "UseFakePublisher": false,
      "PollSeconds": 15,
      "BatchSize": 20,
      "MaxAttempts": 3,
      "StaleMinutes": 10,
      "StartupDelaySeconds": 5
    }
  },
  "Media": {
    "MaxFileMegabytes": 100,
    "Storage": {
      "RootPath": ""
    }
  },
  "Web": {
    "RootPath": ""
  }
}
