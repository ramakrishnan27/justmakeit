{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "platform",
    "Audience": "platform-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimiting": {
    "Auth": {
      "CredentialRequestsPerWindow": 10,
      "SessionRequestsPerWindow": 60,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "WebOrigin": ""
  },
  "Web": {
    "RootPath": ""
  }
}
