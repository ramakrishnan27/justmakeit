<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The folders Auth/, Helpers/ and Infrastructure/ hold what used to be three projects. With the root namespace
         "Platform" their namespaces are what they always were (Platform.Auth.Services, Platform.Helpers.Constants,
         Platform.Infrastructure.Data), so nothing that uses them had to change. -->
    <RootNamespace>Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Migrations\*.sql" LogicalName="Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
